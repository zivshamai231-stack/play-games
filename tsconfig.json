{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": { "@event-content": ["./src/content/birthday-demo.ts"] },
    "types": ["vite/client"]
  },
  "include": ["src/client", "src/shared", "src/content"]
}
